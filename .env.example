# Copia questo file in .env.local e valorizza le chiavi.
# .env.local è ignorato da git: non committare valori reali.

# Token API del portale Higeco (https://testing.higeco.com), usato lato server
# per ottenere il token di sessione da POST /api/v2/authenticate.
# Si trova nella pagina di configurazione utente del portale.
HIGECO_API_TOKEN=
